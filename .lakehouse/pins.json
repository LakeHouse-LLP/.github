{
  "description": "Single source of truth for reusable workflow paths and action pins (SHA). Update here first, then sync workflow files; CI verifies they match.",
  "defaultsWorkflowRef": "main",
  "reusableWorkflows": {
    "labelSync": {
      "repo": ".github",
      "path": ".github/workflows/label-sync.yml",
      "usesSuffix": ".github/.github/workflows/label-sync.yml@main",
      "howToCall": "GitHub requires a literal uses: string. Build it as <orgName from org.json or github.repository_owner> + '/' + usesSuffix."
    },
    "release": {
      "repo": ".github",
      "path": ".github/workflows/release.yml",
      "usesSuffix": ".github/.github/workflows/release.yml@main",
      "howToCall": "Pass runs-on-json: '[\"ubuntu-latest\"]' (public) or self-hosted labels (private). See docs/releasing.md."
    }
  },
  "actions": {
    "checkout": {
      "uses": "actions/checkout",
      "version": "v7.0.1",
      "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1"
    },
    "setup-node": {
      "uses": "actions/setup-node",
      "version": "v7.1.0",
      "sha": "949feb2413d6458794dcd2491c4babbbce0c15c1"
    },
    "labeler": {
      "uses": "crazy-max/ghaction-github-labeler",
      "version": "v6.0.0",
      "sha": "548a7c3603594ec17c819e1239f281a3b801ab4d"
    },
    "attest-build-provenance": {
      "uses": "actions/attest-build-provenance",
      "version": "v4.2.2",
      "sha": "4d101475d8b20a2381f78447822ac1eab6504dd8"
    },
    "gh-release": {
      "uses": "softprops/action-gh-release",
      "version": "v3.0.3",
      "sha": "efb35369e0ad2afab669f228072c1b0d510eae64"
    },
    "changesets": {
      "uses": "changesets/action",
      "version": "v2.1.2",
      "sha": "ae32849d5ba541f9ae29e40e22a623bc13562f51"
    },
    "first-interaction": {
      "uses": "actions/first-interaction",
      "version": "v3.1.0",
      "sha": "1c4688942c71f71d4f5502a26ea67c331730fa4d"
    }
  },
  "tools": {
    "gitleaks": {
      "version": "8.30.1",
      "sha256": {
        "linux_x64": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
      }
    }
  }
}
